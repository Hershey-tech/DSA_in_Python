class Solution:
    def longestCommonPrefix(self, arr1: List[int], arr2: List[int]) -> int:
        
        prefixSet = set()
        
        for num in arr1:
            s = str(num) 
            for i in range(1, len(s) + 1):
                prefixSet.add(s[:i])  
        
        ans = 0
        
        for num in arr2:
            s = str(num)
            for i in range(len(s), 0, -1):
                if s[:i] in prefixSet:
                    ans = max(ans, i)
                    break  
        
        return ans
        
