from functools import lru_cache

class Solution:
    def totalWaviness(self, num1: int, num2: int) -> int:
        
        def solve(n: int) -> int:
            if n < 0:
                return 0

            digits = list(map(int, str(n)))
            m = len(digits)

            @lru_cache(None)
            def dp(pos, tight, started, length, last2, last1):
                if pos == m:
                    return (1, 0)  # (count, total_waviness)

                limit = digits[pos] if tight else 9

                total_count = 0
                total_wav = 0

                for d in range(limit + 1):
                    ntight = tight and (d == limit)

                    if not started:
                        if d == 0:
                            cnt, wav = dp(
                                pos + 1, ntight, False, 0, 10, 10
                            )
                            total_count += cnt
                            total_wav += wav
                        else:
                            cnt, wav = dp(
                                pos + 1, ntight, True, 1, 10, d
                            )
                            total_count += cnt
                            total_wav += wav

                    else:
                        if length == 1:
                            cnt, wav = dp(
                                pos + 1, ntight, True, 2, last1, d
                            )
                            total_count += cnt
                            total_wav += wav

                        else:  # length >= 2
                            contrib = 1 if (
                                (last1 > last2 and last1 > d) or
                                (last1 < last2 and last1 < d)
                            ) else 0

                            cnt, wav = dp(
                                pos + 1, ntight, True, 2, last1, d
                            )

                            total_count += cnt
                            total_wav += wav + cnt * contrib

                return (total_count, total_wav)

            return dp(0, True, False, 0, 10, 10)[1]

        return solve(num2) - solve(num1 - 1)
