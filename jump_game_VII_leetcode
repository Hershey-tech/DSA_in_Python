class Solution:
    def canReach(self, s: str, minJump: int, maxJump: int) -> bool:

        n = len(s)
        queue = [0]
        farthest = 0

        while queue:
            i = queue.pop(0)

            start = max(i + minJump, farthest)
            end = min(i + maxJump, n - 1)

            for j in range(start, end + 1):
                if s[j] == '0':
                    if j == n - 1:
                        return True
                    queue.append(j)

            farthest = i + maxJump + 1

        return n == 1
